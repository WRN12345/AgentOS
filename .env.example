# AgentOS 环境配置示例。复制为 .env 后按环境修改；.env 不提交 Git。
# Compose 仅将 docker-compose.yml 中声明的变量传入容器，修改后需重新创建相关容器。

# 应用
APP_ENV=development

# PostgreSQL：容器内地址 postgres:5432，当前宿主机映射为 0.0.0.0:5436。
# 对外部署前收紧端口绑定与访问规则；修改密码时同步更新 DATABASE_URL，特殊字符需 URL 编码。
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgresql+asyncpg://agentos:change-me-to-a-strong-password@postgres:5432/agentos

# Redis：仅 Compose 网络内可达，默认不发布宿主机端口。
REDIS_URL=redis://redis:6379/0

# LLM：支持 ollama / openai_compatible；启用 AI 分析需填写 LLM_MODEL。
# Ollama 独立运行在宿主机，容器通过 host-gateway 访问。
LLM_PROVIDER=ollama
LLM_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# 模型调用超时（秒）与失败重试次数
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 单次生成最大 token 数（仅 OpenAI 兼容 Provider 生效；推理模型 thinking 也占额度，过小会截断 JSON 输出）
LLM_MAX_TOKENS=4096

# 记忆模块 embedding：默认使用本地 Ollama，复用 OLLAMA_BASE_URL。
# 首次部署需在宿主机执行 ollama pull qwen3-embedding:0.6b。
# 当前应用配置校验和数据库向量列均固定为 1024 维；更换同维度模型需全量重建索引。
# 变更维度需同步调整应用校验并执行数据库迁移，不能只修改此变量或运行重建脚本。
# 维护窗口备份后重建：docker compose exec backend python -m app.scripts.rebuild_memory_index --yes
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSIONS=1024
# 使用智谱等 OpenAI 兼容云端 embedding 时改为以下配置（项目文档内容将发送至第三方）：
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# EMBEDDING_API_KEY=<你的 API Key>
# EMBEDDING_MODEL=embedding-3
# EMBEDDING_DIMENSIONS=1024
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_API_KEY=
# Agent 运行级失败重试：指数退避，间隔 = base * 2^attempt
AGENT_RUN_MAX_RETRIES=3
AGENT_RUN_RETRY_BASE_SECONDS=30

# 日志目录：Compose 中固定为 /app/data/logs，挂载到宿主机 data/logs/。
# 仅修改此处不会改变容器日志路径；运维脚本也会读取 LOG_DIR，路径须符合各自运行环境。
# 本示例用于容器。本地源码运行可通过进程环境覆盖为 data/logs；省略配置也使用仓库根 data/logs。
LOG_DIR=/app/data/logs

# Scheduler 示例任务触发周期（秒）
SCHEDULER_EXAMPLE_INTERVAL_SECONDS=60
# 到期/逾期提醒扫描触发周期（秒）；“临期”判定窗口固定为未来 24 小时
DUE_SCAN_INTERVAL_SECONDS=300
# Workflow Risk Agent 周期风险扫描触发周期（秒，默认 24 小时）
AGENT_RISK_SCAN_INTERVAL_SECONDS=86400

# 新文件写入后端：local | minio；已有文件按数据库记录选择后端
STORAGE_BACKEND=local
# 容器保持此绝对路径；本地源码运行可通过进程环境覆盖为 data/uploads。
# 相对 LOG_DIR/STORAGE_ROOT 按应用项目根解析，与 CWD 无关；已安装包须显式指定绝对路径。
STORAGE_ROOT=/app/data/uploads
# MinIO endpoint 不带协议；bucket 须预先创建并保持私有。
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=agentos-files
MINIO_SECURE=false
# 可选 Compose minio profile 的管理账号，与应用访问账号分开配置。
MINIO_ROOT_USER=agentos-admin
MINIO_ROOT_PASSWORD=
# 上传大小上限（字节）与扩展名/MIME 白名单（逗号分隔）
UPLOAD_MAX_BYTES=20971520
UPLOAD_ALLOWED_EXTENSIONS=.txt,.md,.csv,.json,.pdf,.png,.jpg,.jpeg,.zip,.docx
UPLOAD_ALLOWED_MIME_TYPES=text/plain,text/markdown,text/csv,application/json,application/pdf,image/png,image/jpeg,application/zip,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# 认证：JWT 签名密钥，生产环境必须换成强随机值
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# 初始全局管理员账号：容器启动时幂等创建，不自动成为项目成员。
# 首次启动前设置强密码；修改此配置不会重置已有账号密码。
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
# 启动时创建的默认项目；当前 Compose 未透传此变量，容器使用应用默认值。
# 自定义名称需先在 Compose 的 backend.environment 中透传，或直接配置本地应用环境。
BOOTSTRAP_PROJECT_NAME=AgentOS 项目
# 预留配置：当前 bootstrap 不使用管理员显示名，Compose 也未透传此变量。
BOOTSTRAP_ADMIN_DISPLAY_NAME=管理员
