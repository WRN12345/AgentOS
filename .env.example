# AgentOS 环境配置示例。复制为 .env 后按环境修改；.env 不提交 Git。

# 应用
APP_ENV=development

# PostgreSQL（容器内服务名 postgres，端口仅绑定 127.0.0.1）
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgresql+asyncpg://agentos:change-me-to-a-strong-password@postgres:5432/agentos

# Redis
REDIS_URL=redis://redis:6379/0

# LLM 配置（第 15 章：Ollama 运行在宿主机，容器通过 host-gateway 访问）
LLM_PROVIDER=ollama
LLM_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# 模型调用超时（秒）与失败重试次数（17.3 节）
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# 单次生成最大 token 数（仅 OpenAI 兼容 Provider 生效；推理模型 thinking 也占额度，过小会截断 JSON 输出）
LLM_MAX_TOKENS=4096
# Agent 运行级失败重试（17.3 节，T5.6）：指数退避，间隔 = base * 2^attempt
AGENT_RUN_MAX_RETRIES=3
AGENT_RUN_RETRY_BASE_SECONDS=30

# 日志目录（容器内路径，挂载到 data/logs/）
LOG_DIR=/app/data/logs

# Scheduler 示例任务触发周期（秒）
SCHEDULER_EXAMPLE_INTERVAL_SECONDS=60
# 到期/逾期提醒扫描触发周期（秒）；“临期”判定窗口固定为未来 24 小时
DUE_SCAN_INTERVAL_SECONDS=300
# Workflow Risk Agent 周期风险扫描触发周期（秒，T5.5）
AGENT_RISK_SCAN_INTERVAL_SECONDS=3600

# 文件存储（第 14 章）：存储后端与本地根目录（容器内路径，挂载到 data/uploads/）
STORAGE_BACKEND=local
STORAGE_ROOT=/app/data/uploads
# 上传大小上限（字节）与扩展名/MIME 白名单（逗号分隔）
UPLOAD_MAX_BYTES=20971520
UPLOAD_ALLOWED_EXTENSIONS=.txt,.md,.csv,.json,.pdf,.png,.jpg,.jpeg,.zip
UPLOAD_ALLOWED_MIME_TYPES=text/plain,text/markdown,text/csv,application/json,application/pdf,image/png,image/jpeg,application/zip

# 认证（第 16 章）：JWT 签名密钥，生产环境必须换成强随机值
JWT_SECRET=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# 初始负责人账号（容器启动时幂等创建；生产环境必须改密码）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123
# 默认项目（首版唯一项目）与初始账号的负责人显示名
BOOTSTRAP_PROJECT_NAME=AgentOS 项目
BOOTSTRAP_ADMIN_DISPLAY_NAME=项目负责人
